{
  "name": "@tbo/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TBO Copilot worker: claims Copilot runs from TBO Support and investigates them read-only with the pi engine",
  "bin": {
    "tbo-worker": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js start",
    "eval": "node dist/cli.js eval",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@pi-desktop/agent-host": "workspace:*",
    "@pi-desktop/agent-runtime": "workspace:*",
    "@pi-desktop/host-runtime": "workspace:*",
    "@pi-desktop/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
